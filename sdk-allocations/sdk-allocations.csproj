<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Allocation counter for tools/call over StreamServerTransport.
    Builds against a local clone of the MCP C# SDK, so the same harness can be run against main and against a branch:
      dotnet run -c Release -p:McpSdkRoot=/path/to/csharp-sdk
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <Target Name="CheckMcpSdkRoot" BeforeTargets="Restore;CollectPackageReferences;Build">
    <Error Condition="'$(McpSdkRoot)' == ''" Text="Pass the path of a csharp-sdk clone: -p:McpSdkRoot=/path/to/csharp-sdk" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(McpSdkRoot)/src/ModelContextProtocol/ModelContextProtocol.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>
</Project>
