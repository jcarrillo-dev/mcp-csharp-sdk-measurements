<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>binding</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IlLinkTreatWarningsAsErrors>true</IlLinkTreatWarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <!-- By default the published 2.2.0 package is used. Pass -p:McpSdkRoot=/path/to/csharp-sdk (checked out at the
       tool-parameter-binding branch) to build against it instead: SDK_BRANCH is defined and the SDK disposes the bound values. -->
  <ItemGroup Condition="'$(McpSdkRoot)' == ''">
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(McpSdkRoot)' != ''">
    <ProjectReference Include="$(McpSdkRoot)/src/ModelContextProtocol/ModelContextProtocol.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(McpSdkRoot)' != ''">
    <DefineConstants>$(DefineConstants);SDK_BRANCH</DefineConstants>
  </PropertyGroup>
</Project>
